# --- API ---
API_PORT=4100
JWT_SECRET=change-moi-en-production

# --- Compte administrateur créé au premier lancement ---
ADMIN_EMAIL=admin@edop.com
ADMIN_PASSWORD=edop2026
ADMIN_NAME=Administrateur E-DOP

# --- Cloudinary (upload des images du back-office) ---
# Tableau de bord Cloudinary > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=edop

# --- Brevo (emails transactionnels aux clients) ---
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@edop.com
BREVO_SENDER_NAME=E-DOP
# Copie interne des demandes de devis (laisser vide pour désactiver)
BREVO_NOTIFY_EMAIL=

# URL publique du site (liens dans les emails)
PUBLIC_URL=http://localhost:5173
